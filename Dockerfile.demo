FROM maven:3.9.9-eclipse-temurin-17 AS builder

WORKDIR /app

COPY pom.xml .
RUN mvn -B -q dependency:go-offline

COPY . .
RUN mvn -B -P release clean package -DskipTests

FROM eclipse-temurin:17-jre

WORKDIR /app

COPY --from=builder /app/target/*.jar app.jar
COPY demo/articles /app/demo-articles

# Public demo: every start resets the articles to demo/articles. Run a single instance only.
ENV ARTICLES_DIR=/tmp/articles
ENV SERVER_ADDRESS=0.0.0.0
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=50 -XX:+ExitOnOutOfMemoryError"

EXPOSE 8080

ENTRYPOINT ["sh","-c","rm -rf \"$ARTICLES_DIR\" && mkdir -p \"$ARTICLES_DIR\" && cp /app/demo-articles/*.md \"$ARTICLES_DIR\"/ && exec java -jar app.jar"]
